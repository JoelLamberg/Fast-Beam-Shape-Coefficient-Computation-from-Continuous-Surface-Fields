%RUN_AXICON Driver: Bessel-Gauss beam synthesized on an axicon surface,
% scattered by a homogeneous dielectric sphere (mr = sqrt(1.85)), XZ plane.
% Reproduces the axicon figure of Lamberg et al., Opt. Lett. 50, 4554 (2025),
% using the fast/overflow-safe rewrite mieFromSurfaceField.
%
% Requires AxiconParameters2025New.mat (x,y,z, GB, e_1,e_2,e_3, Area) on path.
clear; addpath(fileparts(mfilename('fullpath')));
% ---------------- physical parameters --------------------------------------
lambda = 1e-3; k = 2*pi/lambda;
a = 0.003; % sphere radius
N = 140; % number of modes
mr = sqrt(1.85);
% ---------------- load the surface field -----------------------------------
S = load('AxiconParameters2025New.mat'); % x,y,z [1xNs]; GB [1xNs]; e_1.. [Nsx3]; Area
Ns = numel(S.x);
yOffset = 0.75*a; zOffset = 0.015; % offsets as in the original script
O = [S.x(:), S.y(:)-yOffset, S.z(:)-zOffset];
% BUG FIX: original used dOmega = 0.000117779/length(1800) -> length(1800)==1,
% i.e. a no-op. Use the true per-point surface element: total Area / Ns.
dA = double(S.Area) / Ns;
src = struct('O',O, 'e1',S.e_1, 'e3',S.e_3, 'E0',S.GB(:), 'dA',dA); % (avoid name 'surf')
% ---------------- evaluation grid (XZ plane, units of a) --------------------
nz = 500;
ys = linspace(-19.5, 16.5, nz);
zs = linspace(-18.00, 18.00, nz);
ys = linspace(-5, 3, nz);
zs = linspace(-4, 4, nz); 
[YY, ZZ] = ndgrid(ys, zs);
Reval = a * [zeros(numel(YY),1), YY(:), ZZ(:)];
% ---------------- run -------------------------------------------------------
opt = struct('k',k,'N',N,'a',a,'mr',mr,'Reval',Reval,'verbose',true, ...
'useParallel',true); % set false to force serial (no toolbox needed)
tic; out = mieFromSurfaceField(src, opt); fprintf('TOTAL: %.2f s\n', toc);
% ---------------- plot |E_total| -------------------------------------------
%%
Etot = sqrt(sum(abs(out.Etot).^2,2));
Emap = reshape(Etot, numel(ys), numel(zs));
figure; surf(ZZ, YY, Emap./max(Emap(:)), 'EdgeColor','none');
view(0,90); axis equal tight; colormap jet; colorbar;
xlabel('z / a'); ylabel('y / a'); title('Axicon Bessel-Gauss |E_{tot}| (normalized)');
