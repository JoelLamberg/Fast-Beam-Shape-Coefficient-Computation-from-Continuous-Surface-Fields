%RUN_CVB Driver: azimuthally-polarized cylindrical vector beam (CVB) on a
% spherical-cap surface, scattered by a homogeneous sphere, in the XZ plane.
% Reproduces the CVB figure of Lamberg et al., Opt. Lett. 50, 4554 (2025),
% using the fast/overflow-safe rewrite mieFromSurfaceField.
%
% Requires CVB_azimuthal_804.mat (Xeva,Yeva,Zeva, E_0, e_1,e_2,e_3) on the path.
clear; addpath(fileparts(mfilename('fullpath')));
% ---------------- physical parameters --------------------------------------
lambda = 0.5e-3; k = 2*pi/lambda;
a = 0.003; % sphere radius
N = 100; % number of modes
mr = sqrt(1.85); % refractive index (1 => no scatterer; Fig. (a))
% ---------------- load the surface field -----------------------------------
S = load('CVB_azimuthal_804.mat'); % Xeva,Yeva,Zeva [1xNs]; e_1.. [Nsx3]; E_0 [1xNs]
Ns = numel(S.Xeva);
yOffset = 0.75*a; % off-axis displacement (as in original)
O = [S.Xeva(:), S.Yeva(:)-yOffset, S.Zeva(:)];
% NOTE original surface-area element: total Omega area / Ns (the constant
% 0.000117779 is the cap area; the original divided it by length(Xeva)).
dA = 0.000117779 / Ns;
src = struct('O',O, 'e1',S.e_1, 'e3',S.e_3, 'E0',S.E_0(:), 'dA',dA); % (avoid name 'surf')
% ---------------- evaluation grid (XZ plane, units of a) --------------------
nz = 1000;
ys = linspace(-5.00, 3.00, nz); % y / a
zs = linspace(-4.00, 4.00, nz); % z / a
[YY, ZZ] = ndgrid(ys, zs);
Reval = a * [zeros(numel(YY),1), YY(:), ZZ(:)]; % physical coords, x=0 plane
% ---------------- run -------------------------------------------------------
opt = struct('k',k,'N',N,'a',a,'mr',mr,'Reval',Reval,'verbose',true, ...
'useParallel',true); % set false to force serial (no toolbox needed)
tic; out = mieFromSurfaceField(src, opt); fprintf('TOTAL: %.2f s\n', toc);
% ---------------- plot |E_total| -------------------------------------------
%%
Etot = sqrt(sum(abs(out.Etot).^2,2));
Emap = reshape(Etot, numel(ys), numel(zs));
figure; 
surf(ZZ, YY, Emap./max(Emap(:)), 'EdgeColor','none');
view(0,90); axis equal tight; colormap jet; colorbar;
xlabel('z / a'); ylabel('y / a'); title('CVB |E_{tot}| (normalized)');
